    "clinical-records": { "type": "application", "root": "apps/clinical-records", "entryFile": "main", "sourceRoot": "apps/clinical-records/src", "compilerOptions": { "tsConfigPath": "apps/clinical-records/tsconfig.app.json" } }
  }
