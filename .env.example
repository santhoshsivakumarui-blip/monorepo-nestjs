# Postgres is a third-party managed instance (e.g. Neon) — there is no
# `postgres` service in docker-compose.yml. DATABASE_URL below is a fallback
# used by db:migrate:sql when a target has no <KEY>_DATABASE_URL of its own;
# each service otherwise gets its own database via the <KEY>_DATABASE_URL
# vars further down, so one credential leak/rotation stays scoped to one
# service's data.
POSTGRES_HOST=replace-with-your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=replace-with-db-name
DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/replace-with-db-name?sslmode=require
JWT_SECRET=replace-with-long-random-secret
JWT_ISSUER=platform-production
JWT_AUDIENCE=platform-api
OIDC_ISSUER=http://keycloak:8080/realms/platform
OIDC_AUDIENCE=api-gateway
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=
TEMPORAL_ADDRESS=
UNLEASH_URL=
UNLEASH_CLIENT_KEY=
SMTP_HOST=mailpit
SMTP_PORT=1025
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379
KAFKA_BROKERS=kafka:9092
RABBITMQ_URL=amqp://platform:replace-with-strong-rabbitmq-password@rabbitmq:5672
ELASTICSEARCH_NODE=http://elasticsearch:9200

# One managed-Postgres database per service — same host/user/password as
# POSTGRES_* above, different database name per URL. Read directly by
# docker-compose.yml's per-service DATABASE_URL, and by
# `npm run db:migrate:sql -- <key>` (key matches the folder name under
# infra/postgres/migrations/) to provision/migrate each one.
USERS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/users_db?sslmode=require
ORDERS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/orders_db?sslmode=require
NOTIFICATIONS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/notifications_db?sslmode=require
EMAIL_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/email_db?sslmode=require
SMS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/sms_db?sslmode=require
ADMIN_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/admin_db?sslmode=require
SUBSCRIPTIONS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/subscriptions_db?sslmode=require
VITALS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/vitals_db?sslmode=require
CLINICAL_RECORDS_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/clinical_records_db?sslmode=require
# Used by `npm run db:migrate:sql -- shared_pool` to reach the shared pooled
# tenant database (see docs/database-tenancy-strategy.md).
SHARED_POOL_DATABASE_URL=postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/shared_pool_db?sslmode=require
# Consumed directly by apps/admin (libs/tenancy's connection manager), keyed by
# tenant_database_assignments.database_key. Only the shared pool lives here —
# a dedicated Enterprise tenant's connection string is stored encrypted in
# admin_db's tenant_database_secrets table instead (see
# libs/tenancy/src/secret-store.ts). In production this env-var lookup itself
# is replaced by a real secrets-manager reference via tenants.vault_secret_path.
TENANT_DB_CONNECTIONS={"shared_pool_db":"postgresql://replace-with-db-user:replace-with-strong-db-password@replace-with-your-postgres-host/shared_pool_db?sslmode=require"}
# AES-256 key (32 bytes, base64) encrypting tenant_database_secrets rows.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRETS_KEY=replace-with-a-generated-32-byte-base64-key
