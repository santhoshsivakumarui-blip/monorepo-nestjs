{
  "name": "platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "npm run build:all",
    "build:all": "nest build api-gateway && nest build users && nest build orders && nest build notifications && nest build email && nest build sms && nest build admin && nest build subscriptions && nest build vitals && nest build clinical-records",
    "start:gateway": "nest start api-gateway --watch",
    "start:users": "nest start users --watch",
    "start:orders": "nest start orders --watch",
    "start:notifications": "nest start notifications --watch",
    "start:email": "nest start email --watch",
    "start:sms": "nest start sms --watch",
    "start:admin": "nest start admin --watch",
    "start:subscriptions": "nest start subscriptions --watch",
    "start:vitals": "nest start vitals --watch",
    "start:clinical-records": "nest start clinical-records --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:sql": "node scripts/db-migrate.js",
    "generate:service": "node scripts/generate-service.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:env": "node scripts/check-env.js",
    "check:prod": "node scripts/check-prod-readiness.js",
    "check:dr": "node scripts/check-dr-readiness.js",
    "check:ops": "node scripts/check-platform-ops.js",
    "check:failover": "node scripts/check-runtime-failover.js",
    "smoke:test": "node scripts/smoke-test.js",
    "outbox:relay": "ts-node workers/outbox-relay.ts",
    "idempotency:cleanup": "ts-node workers/idempotency-cleanup.ts",
    "start:dev": "nest start --watch",
    "lint": "npm run check:architecture && eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest --config test/jest.integration.js --runInBand",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,json,yml,yaml,md}\""
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.6.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.6.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
